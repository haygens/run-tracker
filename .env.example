# Copy this file to .env and set your own password (.env is gitignored).
# Keep the single quotes: without them, a # in the password starts a comment.
# The server refuses to start while the password is still change-me.
WRITE_PASSWORD='change-me'

# Optional: Turso (hosted SQLite), the same database the Vercel deploy uses.
# Leave these out to use runs.db on this computer. Never commit the token.
# TURSO_DATABASE_URL='libsql://your-database.turso.io'
# TURSO_AUTH_TOKEN='your-token'
